{
  "name": "digital-atlas",
  "scripts": {
    "start": "yarn serve",
    "ng": "node --openssl-legacy-provider ./node_modules/@angular/cli/bin/ng",
    "build": "./download-images.sh && yarn build:colors && yarn ng build",
    "test": "yarn build:colors && yarn ng test",
    "lint": "yarn ng lint",
    "build:colors": "cd src && node build-colors.js",
    "serve": "yarn build:colors && yarn ng serve",
    "stop": "lsof -t -i tcp:4200 | xargs kill -9 || echo \"not running\"",
    "watch": "yarn ng build --configuration production --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "~13.4.0",
    "@angular/common": "~13.4.0",
    "@angular/compiler": "~13.4.0",
    "@angular/core": "~13.4.0",
    "@angular/forms": "~13.4.0",
    "@angular/platform-browser": "~13.4.0",
    "@angular/platform-browser-dynamic": "~13.4.0",
    "@angular/router": "~13.4.0",
    "@fortawesome/angular-fontawesome": "^0.10.2",
    "@fortawesome/fontawesome-svg-core": "^1.2.32",
    "@fortawesome/free-solid-svg-icons": "^5.15.1",
    "@types/underscore": "^1.11.4",
    "bulma": "^0.9.1",
    "d3": "^7.4.4",
    "moment": "^2.29.2",
    "primeicons": "^5.0.0",
    "primeng": "^13.4.1",
    "rxjs": "~6.6.0",
    "smoothscroll-polyfill": "^0.4.4",
    "topojson": "^3.0.2",
    "tslib": "^2.0.0",
    "underscore": "^1.13.2",
    "zone.js": "~0.11.4"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~13.3.11",
    "@angular/cli": "~13.3.11",
    "@angular/compiler-cli": "~13.4.0",
    "@angular/localize": "13.4.0",
    "@types/d3": "^7.1.0",
    "@types/jasmine": "~3.6.0",
    "@types/node": "^12.11.1",
    "codelyzer": "^6.0.0",
    "jasmine-core": "~3.6.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "~6.3.2",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage": "~2.0.3",
    "karma-jasmine": "~4.0.0",
    "karma-jasmine-html-reporter": "~1.5.0",
    "protractor": "~7.0.0",
    "ts-node": "~8.3.0",
    "tslint": "~6.1.0",
    "typescript": "~4.6.4"
  }
}
